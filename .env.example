# Copy to .env and fill in. The same .env is used on this computer (the VS Code
# task runs `uv run --env-file .env`) and on the DiskStation (`docker run --env-file`).
# Never commit .env.
#
# Don't put DJANGO_DEBUG here: the VS Code task turns debug on locally and the
# Dockerfile keeps it off on the DiskStation.

# Weather lookups on the Add Log page.
OPENWEATHER_API_KEY=your-openweathermap-api-key

# Signs logins and forms. Make one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me
